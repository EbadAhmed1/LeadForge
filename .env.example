# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_in_production_use_openssl_rand_hex_32
APP_VERSION=0.1.0

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saas_db

# These are assembled by docker-compose from the vars above.
# Set manually if running outside Docker.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saas_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/saas_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6379/0

# ─── Authentication ───────────────────────────────────────────────────────────
# Same value as SECRET_KEY above — must match on both backend and frontend (JWT_SECRET)
# JWT tokens expire in 30 days by default (see ACCESS_TOKEN_EXPIRE_MINUTES)

# ─── Email Verification (Resend) ──────────────────────────────────────────────
# Get your key at https://resend.com
RESEND_API_KEY=re_...
# "From" address for outgoing emails (must be a verified domain in Resend)
EMAIL_FROM=LeadForge <onboarding@resend.dev>

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: https://your-backend-domain/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=Ov23...
GITHUB_CLIENT_SECRET=...

# ─── URLs (used for OAuth redirects and email links) ─────────────────────────
BACKEND_URL=https://leadforge-saas.duckdns.org
FRONTEND_URL=https://your-app.vercel.app

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins — must include FRONTEND_URL value
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ─── LLM / AI Engine ──────────────────────────────────────────────────────────
# Provider: "openai" | "anthropic"
LLM_PROVIDER=openai
# Model (change to claude-3-5-haiku-20241022 for Anthropic)
LLM_MODEL=gpt-4o-mini

# OpenAI — required if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Anthropic — required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Firecrawl Web Scraper
FIRECRAWL_API_KEY=fc-...

# Tavily Web Search Engine
TAVILY_API_KEY=tvly-...

# ─── LangSmith Tracing ────────────────────────────────────────────────────────
# Set LANGCHAIN_TRACING_V2=true to enable. No code changes needed.
# Get your key at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=saas-lead-pipeline
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─── Firecrawl Web Scraper ────────────────────────────────────────────────────
# Get your free key at https://firecrawl.dev (500 free credits/month)
# Each scrape of 1 URL = 1 credit
FIRECRAWL_API_KEY=fc-...
